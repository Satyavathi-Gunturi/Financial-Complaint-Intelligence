one;" vertex="1" parent="1"><mxGeometry x="63" y="959" width="1574" height="22" as="geometry" /></mxCell><mxCell id="text68" value="Full retained-window rebuild favors reproducibility over incremental cost; full-scale runner acceptance remains open." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="987" width="1574" height="20" as="geometry" /></mxCell><mxCell id="text69" value="Separate aggregate serving keeps large complaint/narrative databases out of the dashboard deployment." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="1008" width="1574" height="20" as="geometry" /></mxCell><mxCell id="text70" value="Current source download is blocked by HTTP 403. Durable source versions and hosted AI detail access remain future work." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="1029" width="1574" height="20" as="geometry" /></mxCell><mxCell id="text71" value="LEGEND  ·  Filled icons = component type  |  Solid cards = implemented  |  Dashed cards = planned" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="1095" width="1500" height="20" as="geometry" /></mxCell><mxCell id="text72" value="Solid arrows = data / publication flow  |  Dashed arrows = control / development flow  |  Processing is batch-based; no streaming or live-backlog service" style="text;html=0;align=left;ve