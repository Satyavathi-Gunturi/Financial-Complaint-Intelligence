<mxfile host="app.diagrams.net"><diagram name="Financial Complaint Intelligence" id="system-architecture"><mxGraphModel dx="1400" dy="880" grid="1" page="1" pageWidth="1400" pageHeight="880"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" edge="1" parent="1" source="source" target="schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="schedule" target="ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="ingest" target="dbt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="dbt" target="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="gate" target="exports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" edge="1" parent="1" source="exports" target="pr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" edge="1" parent="1" source="pr" target="dash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" edge="1" parent="1" source="store" target="ai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="source" value="CFPB public archives&lt;br&gt;Official ZIP catalogue&lt;br&gt;HTTP validators + SHA-256&lt;br&gt;Source release timing is external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="135" width="300" height="160" as="geometry" /></mxCell><mxCell id="schedule" value="GitHub Actions&lt;br&gt;Daily 11:23 UTC + manual run&lt;br&gt;Compare source / code revision&lt;br&gt;Skip unchanged releases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="380" y="135" width="300" height="160" as="geometry" /></mxCell><mxCell id="ingest" value="Rolling bronze ingestion&lt;br&gt;36 months by received date&lt;br&gt;Latest release wins overlapping IDs&lt;br&gt;CSV chunks + provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="710" y="135" width="300" height="160" as="geometry" /></mxCell><mxCell id="dbt" value="DuckDB + dbt&lt;br&gt;Staging → 8 silver tables&lt;br&gt;Wide gold + parallel star schema&lt;br&gt;Temporary runner database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="1040" y="135" width="300" height="160" as="geometry" /></mxCell><mxCell id="gate" value="Validation gate&lt;br&gt;21 models / 126 dbt tests&lt;br&gt;Four export totals reconcile&lt;br&gt;Failed build keeps last release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="1040" y="370" width="300" height="160" as="geometry" /></mxCell><mxCell id="exports" value="Four serving datasets&lt;br&gt;Daily company / product + issues&lt;br&gt;State + submission channel&lt;br&gt;One revision manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="710" y="370" width="300" height="160" as="geometry" /></mxCell><mxCell id="pr" value="Branch → PR → merge&lt;br&gt;Validation evidence in PR&lt;br&gt;Merge commit; respect repo rules&lt;br&gt;Bot PR setting must allow creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="300" height="160" as="geometry" /></mxCell><mxCell id="dash" value="Streamlit dashboard&lt;br&gt;Six tabs + shared filters&lt;br&gt;Version-aware query cache&lt;br&gt;Coverage + last validation time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="300" height="160" as="geometry" /></mxCell><mxCell id="colab" value="Development and recovery&lt;br&gt;Live Colab notebook remains the interactive reference&lt;br&gt;Drive checkpoints remain unchanged; runner caches are disposable&lt;br&gt;First full scheduled publication still needs acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="630" height="150" as="geometry" /></mxCell><mxCell id="store" value="Detailed-data service&lt;br&gt;PLANNED&lt;br&gt;Persistent SQL / narrative access&lt;br&gt;Runner DB is not a hosted service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="640" width="300" height="150" as="geometry" /></mxCell><mxCell id="ai" value="Evidence-backed AI agent&lt;br&gt;PLANNED&lt;br&gt;Read-only SQL + narrative retrieval&lt;br&gt;LLM + accuracy / citation evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;dashed=1;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="300" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>