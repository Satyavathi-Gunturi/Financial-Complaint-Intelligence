<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Refresh and Serving Contracts" id="low-level-contracts"><mxGraphModel dx="1400" dy="880" grid="1" page="1" pageWidth="1400" pageHeight="880"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" edge="1" parent="1" source="source" target="window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="window" target="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="identity" target="stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="stage" target="silver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="silver" target="gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" edge="1" parent="1" source="gold" target="export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" edge="1" parent="1" source="export" target="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" edge="1" parent="1" source="publish" target="serve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#7f93a6;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="source" value="1 / Source identity&lt;br&gt;Allowlisted official HTTPS archive links&lt;br&gt;Verified cached ZIP bytes + validators&lt;br&gt;SHA-256 sources / code / window revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="135" width="400" height="165" as="geometry" /></mxCell><mxCell id="window" value="2 / Retention contract&lt;br&gt;Latest archive-labelled month anchors window&lt;br&gt;Keep [start, end) received dates; 36 months&lt;br&gt;Reject invalid dates / missing IDs / fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="135" width="400" height="165" as="geometry" /></mxCell><mxCell id="identity" value="3 / Complaint identity&lt;br&gt;Preserve source filename and record number&lt;br&gt;Higher archive ordinal wins overlapping IDs&lt;br&gt;One winning bronze row per complaint ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="950" y="135" width="400" height="165" as="geometry" /></mxCell><mxCell id="gold" value="6 / Parallel gold&lt;br&gt;One complaint per wide-gold and star fact row&lt;br&gt;Shared 18 additive count flags&lt;br&gt;Star facts reconcile to wide-gold totals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="400" height="165" as="geometry" /></mxCell><mxCell id="silver" value="5 / Silver relationships&lt;br&gt;Eight relational tables + tag bridge&lt;br&gt;Stable category keys from JSON values&lt;br&gt;Tag filters must not multiply complaints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="385" width="400" height="165" as="geometry" /></mxCell><mxCell id="stage" value="4 / Typed staging&lt;br&gt;Trim categories; parse dates and timeliness&lt;br&gt;Preserve nonblank customer narratives&lt;br&gt;No additional date filtering in staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="950" y="385" width="400" height="165" as="geometry" /></mxCell><mxCell id="export" value="7 / Export gate&lt;br&gt;Four independent daily aggregate grains&lt;br&gt;Each flag total matches wide gold exactly&lt;br&gt;Reject serving files at or above 90 MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="635" width="400" height="165" as="geometry" /></mxCell><mxCell id="publish" value="8 / Release boundary&lt;br&gt;Stage all files + source / validation manifest&lt;br&gt;Commit on release branch; PR; merge commit&lt;br&gt;Failure before merge preserves serving data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="635" width="400" height="165" as="geometry" /></mxCell><mxCell id="serve" value="9 / Dashboard contract&lt;br&gt;Parameterized DuckDB queries; shared filters&lt;br&gt;Cache key includes file mtime and size&lt;br&gt;K/M/B display; exact CSV download values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d1dc;fontColor=#18344f;fontSize=15;spacing=16;" vertex="1" parent="1"><mxGeometry x="950" y="635" width="400" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>