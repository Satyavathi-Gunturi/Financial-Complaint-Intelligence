 as="geometry" /></mxCell><mxCell id="text48" value="FAILURE / EVIDENCE CONTRACT" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#B84C48;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="889" width="749" height="22" as="geometry" /></mxCell><mxCell id="text49" value="Discovery, download and validation failures can abort from any processing state." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="917" width="749" height="20" as="geometry" /></mxCell><mxCell id="text50" value="Build logs, run_results and manifest are uploaded with if: always()." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="938" width="749" height="20" as="geometry" /></mxCell><mxCell id="text51" value="Evidence artifacts last 14 days; ZIP cache is not durable source-version storage." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="959" width="749" height="20" as="geometry" /></mxCell><mxCell id="text52" value="Current observed failure: HTTP 403 at the first hosted archive download." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="980" width="749" height="20" as="geometry" /></mxCell><mxCell id="botnote" value="" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C1CFDD;dashed=0;" vertex="1" parent="1"><mxGeometry x="870" y="875" width="785" height="175" as="geometry" /></mxCell><mxCell id="text53" value="CONCURRENCY / REPOSITORY RULES" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#7555A1;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="888" y="889" width="749" height="22" as="geometry" /></mxCell><mxCell id="text54" value="New main refresh runs cancel older runs in the same concurrency group." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="888" y="917" width="749" height="20" as="geometry" /></mxCell><mxCell id="text55" value="GITHUB_TOKEN-created PRs do not trigger independent PR Actions CI." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="888" y="938" width="749" height="20" as="geometry" /></mxCell><mxCell id="text56" value="Full validation runs before PR creation; no protected-branch bypass." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="888" y="959" width="749" height="20" as="geometry" /></mxCell><mxCell id="text57" value="Source-download resolution and first full rolling publication remain open." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="888" y="980" width="749" height="20" as="geometry" /></mxCell><mxCell id="text58" value="LEGEND  ·  Filled icons = component type  |  Solid cards = implemented  |  Dashed cards = planned" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="1115" width="1500" height="20" as="geometry" /></mxCell><mxCell id="text59" value="Solid arrows = data / publication flow  |  Dashed arrows = control / development flow  |  Source failures never imply a successful data refresh" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#63758A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="1138" width="1500" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>